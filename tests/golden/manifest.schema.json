{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoldenSetManifest",
  "description": "Schema for Dev.Pre-Evaluation golden set evaluation manifests (TC-102, NFR-002)",
  "type": "object",
  "required": ["manifest_version", "dataset_name", "samples"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file_path", "sha256", "split"],
        "properties": {
          "id": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "split": {
            "type": "string",
            "enum": ["tuning", "final"]
          },
          "expected_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule_code", "status"],
              "properties": {
                "rule_code": { "type": "string" },
                "status": {
                  "type": "string",
                  "enum": ["violation", "suspected", "insufficient_information"]
                },
                "severity": {
                  "type": "string",
                  "enum": ["high", "medium", "low"]
                }
              }
            }
          },
          "expected_evidence_queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
